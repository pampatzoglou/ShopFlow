{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/main/.schema/devbox.schema.json",
  "packages": [
    "go-task@3.53",
    "jq@1.8",
    "yq-go@4.54",
    "kubectl@1.34",
    "kubernetes-helm@4.3",
    "kind@0.33",
    "istioctl@1.29",
    "skaffold@2.25",
    "kubeconform@0.8",
    "kubescape@4.0",
    "hadolint@2.14",
    "trivy@0.76",
    "temurin-bin-21@21.0",
    "nodejs@22",
    "python@3.12",
    "uv@0.13",
    "pre-commit@4.6",
    "k6@2.4"
  ],
  "shell": {
    "init_hook": [
      "pre-commit install >/dev/null"
    ],
    "scripts": {
      "deploy": [
        "task deploy"
      ],
      "test": [
        "task test"
      ],
      "lint": [
        "task lint"
      ],
      "build": [
        "task build"
      ],
      "run": [
        "task run"
      ],
      "dev": [
        "task dev"
      ],
      "status": [
        "task status"
      ],
      "clean": [
        "task clean"
      ],
      "cluster:up": [
        "task cluster:up"
      ],
      "cluster:down": [
        "task cluster:down"
      ],
      "cluster:reset": [
        "task cluster:reset"
      ]
    }
  }
}
